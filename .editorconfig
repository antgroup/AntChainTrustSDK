# EditorConfig — https://editorconfig.org
# Covers editor defaults only. The formatting entry point is tools/format.sh.

root = true

[*]
end_of_line       = lf
charset           = utf-8
indent_style      = space
indent_size       = 4
tab_width         = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length   = 80

[*.{yml,yaml}]
indent_size       = 2

[Makefile]
indent_style      = tab

[{LICENSE,NOTICE}]
insert_final_newline = false
trim_trailing_whitespace = false

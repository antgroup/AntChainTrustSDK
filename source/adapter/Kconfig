menu "Adapter"

choice ACTRUST_ADAPTER_PLATFORM
    prompt "Target platform"
    default ACTRUST_ADAPTER_PLATFORM_LINUX
    help
        Select the target platform. This determines which adapter
        implementation is compiled (POSIX, SIMCom SDK, etc.).

config ACTRUST_ADAPTER_PLATFORM_LINUX
    bool "Linux"

config ACTRUST_ADAPTER_PLATFORM_ANDROID
    bool "Android"

config ACTRUST_ADAPTER_PLATFORM_SIMCOM_A7606E
    bool "SIMCom A7606E-H"

endchoice

menu "Security Slots"

config ACTRUST_SEC_SLOT_KEY_BASE
    hex "Key slot base ID"
    default 0x1000
    help
        Base hardware slot ID for cryptographic key storage (EC key pairs,
        AES keys). ACTRUST_SEC_SLOT_KEY(n) maps to this base plus n for
        platforms with contiguous key slots.

config ACTRUST_SEC_SLOT_KEY_COUNT
    int "Key slot count"
    default 8
    range 1 16

config ACTRUST_SEC_SLOT_DATA_BASE
    hex "Data slot base ID"
    default 0x2000
    help
        Base hardware slot ID for general-purpose secure data blobs.
        ACTRUST_SEC_SLOT_DATA(n) maps to this base plus n for platforms
        with contiguous data slots.

config ACTRUST_SEC_SLOT_DATA_COUNT
    int "Data slot count"
    default 8
    range 1 16

config ACTRUST_SEC_SLOT_CERT_BASE
    hex "Certificate slot base ID"
    default 0x3000
    help
        Base hardware slot ID for X.509 certificate storage.
        ACTRUST_SEC_SLOT_CERT(n) maps to this base plus n for platforms
        with contiguous certificate slots.

config ACTRUST_SEC_SLOT_CERT_COUNT
    int "Certificate slot count"
    default 8
    range 1 16

endmenu

menu "Security HW Capabilities"

config ACTRUST_SEC_HW_RANDOM
    bool "Hardware RNG"
    default n
    help
        Platform provides a hardware random number generator
        via actrust_sec_random().

config ACTRUST_SEC_HW_KEY_MGMT
    bool "Hardware key management"
    default n
    help
        Platform can generate, store, delete, and export keys
        inside a TEE / secure element.

config ACTRUST_SEC_HW_ECDSA
    bool "Hardware ECDSA sign/verify"
    default n
    depends on ACTRUST_SEC_HW_KEY_MGMT

config ACTRUST_SEC_HW_HASH
    bool "Hardware hash"
    default n

config ACTRUST_SEC_HW_AES
    bool "Hardware AES encrypt/decrypt"
    default n
    depends on ACTRUST_SEC_HW_KEY_MGMT

endmenu

if ACTRUST_ADAPTER_PLATFORM_LINUX

menu "Storage (Linux)"

config ACTRUST_STORAGE_BASE_DIR
    string "KV storage directory"
    default ".actrust/storage"
    help
        Base directory for file-backed KV storage. Each storage ID
        maps to a file: <prefix><id_hex>.bin.

config ACTRUST_SEC_STORE_BASE_DIR
    string "Secure storage directory"
    default ".actrust/security"
    help
        Base directory for file-backed security slots (keys, certs, data).
        This Linux adapter is a reference/development implementation, not a
        production secure-store or key-isolation boundary. Changing this path
        does not provide hardware-backed confidentiality, anti-tamper
        protection, rollback protection, or non-exportable private-key storage.
        Products that need to protect private keys must replace or extend the
        adapter with the target platform's actual TEE, secure element, TPM, or
        equivalent secure storage/key-management service.

config ACTRUST_STORAGE_FILE_PREFIX
    string "Storage file prefix"
    default "actrust_kv_"

config ACTRUST_STORAGE_REGION_SIZE
    int "Storage region size"
    default 75000
    help
        Logical byte capacity reserved for each file-backed storage region.
        The value must be large enough for the configured KV journal layout.

endmenu

endif

if ACTRUST_ADAPTER_PLATFORM_ANDROID

menu "Storage (Android)"

config ACTRUST_STORAGE_BASE_DIR
    string "KV storage directory"
    default "/data/local/tmp/actrust/storage"
    help
        Base directory for file-backed KV storage on Android. For production
        apps, override this to an app-private writable directory such as
        /data/data/<package>/files/actrust/storage.

config ACTRUST_SEC_STORE_BASE_DIR
    string "Secure storage directory"
    default "/data/local/tmp/actrust/security"
    help
        Base directory for file-backed security slots. This Android adapter is
        a reference/development implementation, not a production secure-store
        or key-isolation boundary. Changing this path, even to an app-private
        writable directory, does not provide Android Keystore/TEE-backed
        confidentiality, anti-tamper protection, rollback protection, or
        non-exportable private-key storage. Products that need to protect
        private keys must replace or extend the adapter with the target
        device's actual Android Keystore, TEE, secure element, or equivalent
        secure storage/key-management service.

config ACTRUST_STORAGE_FILE_PREFIX
    string "Storage file prefix"
    default "actrust_kv_"

config ACTRUST_STORAGE_REGION_SIZE
    int "Storage region size"
    default 75000
    help
        Logical byte capacity reserved for each file-backed storage region.
        The value must be large enough for the configured KV journal layout.

endmenu

endif

if ACTRUST_ADAPTER_PLATFORM_SIMCOM_A7606E

menu "Storage (SIMCom A7606E)"

config ACTRUST_STORAGE_BASE_DIR
    string "KV storage directory"
    default "/data/actrust/storage"
    help
        Base directory on the /data partition (persistent across reboots).

config ACTRUST_STORAGE_FILE_PREFIX
    string "Storage file prefix"
    default "actrust_kv_"

config ACTRUST_STORAGE_REGION_SIZE
    int "Storage region size"
    default 75000
    help
        Logical byte capacity reserved for each file-backed storage region.
        The value must be large enough for the configured KV journal layout.

endmenu

endif

endmenu
